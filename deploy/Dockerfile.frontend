FROM node:22-alpine AS builder

WORKDIR /app
COPY apps/business-console/package.json apps/business-console/package-lock.json ./
RUN npm ci
COPY apps/business-console/ ./
ARG VITE_BUSINESS_API_BASE_URL=http://localhost:3000
ARG VITE_BUSINESS_API_TOKEN=dev-only-secret
ENV VITE_BUSINESS_API_BASE_URL=$VITE_BUSINESS_API_BASE_URL
ENV VITE_BUSINESS_API_TOKEN=$VITE_BUSINESS_API_TOKEN
RUN npm run build

FROM nginx:1.27-alpine
COPY deploy/demo/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/dist /usr/share/nginx/html
