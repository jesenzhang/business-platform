{
  "openapi": "3.1.0",
  "info": {
    "title": "Business Platform Public API",
    "version": "v1",
    "description": "Stable tenant-scoped REST surface for documents, durable processing, governance, and audit. Internal storage keys, raw text, credentials, and provider prompts are never public fields."
  },
  "servers": [{ "url": "http://localhost:3000" }],
  "security": [{ "bearerAuth": [] }],
  "paths": {
    "/health/live": { "get": { "security": [], "responses": { "200": { "description": "Liveness" } } } },
    "/health/ready": { "get": { "security": [], "responses": { "200": { "description": "Readiness" }, "503": { "$ref": "#/components/responses/Error" } } } },
    "/api/v1/documents": {
      "get": {
        "summary": "List documents",
        "parameters": [{ "$ref": "#/components/parameters/Limit" }, { "$ref": "#/components/parameters/Cursor" }],
        "responses": { "200": { "description": "Document page", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/DocumentPageResponse" } } } }, "401": { "$ref": "#/components/responses/Error" } }
      }
    },
    "/api/v1/documents/upload": {
      "post": {
        "summary": "Upload a document and create its metadata",
        "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }],
        "requestBody": { "required": true, "content": { "multipart/form-data": { "schema": { "type": "object", "required": ["file"], "properties": { "file": { "type": "string", "format": "binary" } } } } } },
        "responses": { "201": { "description": "Created document", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/DocumentResponse" } } } }, "200": { "description": "Idempotent replay", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/DocumentResponse" } } } }, "400": { "$ref": "#/components/responses/Error" } }
      }
    },
    "/api/v1/documents/{documentId}": {
      "get": {
        "summary": "Get a document",
        "parameters": [{ "$ref": "#/components/parameters/DocumentId" }],
        "responses": { "200": { "description": "Document", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/DocumentResponse" } } } }, "404": { "$ref": "#/components/responses/Error" } }
      }
    },
    "/api/v1/documents/{documentId}/processing-jobs": {
      "get": {
        "summary": "List processing jobs for a document",
        "parameters": [{ "$ref": "#/components/parameters/DocumentId" }],
        "responses": { "200": { "description": "Processing jobs", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ProcessingJobArrayResponse" } } } } }
      },
      "post": {
        "summary": "Start durable processing for a content revision",
        "parameters": [{ "$ref": "#/components/parameters/DocumentId" }, { "$ref": "#/components/parameters/IdempotencyKey" }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/StartProcessingRequest" } } } },
        "responses": { "201": { "$ref": "#/components/responses/ProcessingJob" }, "200": { "$ref": "#/components/responses/ProcessingJob" }, "409": { "$ref": "#/components/responses/Error" } }
      }
    },
    "/api/v1/processing-jobs": {
      "get": {
        "summary": "List processing jobs",
        "parameters": [{ "$ref": "#/components/parameters/Limit" }, { "$ref": "#/components/parameters/Cursor" }],
        "responses": { "200": { "description": "Processing job page", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ProcessingJobPageResponse" } } } } }
      }
    },
    "/api/v1/processing-jobs/{jobId}": {
      "get": { "summary": "Get a processing job", "parameters": [{ "$ref": "#/components/parameters/JobId" }], "responses": { "200": { "$ref": "#/components/responses/ProcessingJob" }, "404": { "$ref": "#/components/responses/Error" } } }
    },
    "/api/v1/processing-jobs/{jobId}/candidate": {
      "get": { "summary": "Get a bounded extraction candidate", "parameters": [{ "$ref": "#/components/parameters/JobId" }], "responses": { "200": { "$ref": "#/components/responses/Candidate" }, "404": { "$ref": "#/components/responses/Error" } } }
    },
    "/api/v1/processing-jobs/{jobId}/review": {
      "post": {
        "summary": "Review a candidate",
        "parameters": [{ "$ref": "#/components/parameters/JobId" }, { "$ref": "#/components/parameters/IdempotencyKey" }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ReviewRequest" } } } },
        "responses": { "200": { "$ref": "#/components/responses/ReviewResult" }, "409": { "$ref": "#/components/responses/Error" } }
      }
    },
    "/api/v1/operations/overview": {
      "get": { "summary": "Get the fixed operational overview", "responses": { "200": { "description": "Operational overview", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/OverviewResponse" } } } } } }
    },
    "/api/v1/admin/integrity/findings": {
      "get": { "summary": "List integrity findings", "parameters": [{ "$ref": "#/components/parameters/Limit" }], "responses": { "200": { "description": "Finding page", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/FindingPageResponse" } } } } } }
    },
    "/api/v1/admin/integrity/findings/{id}": {
      "get": { "summary": "Get an integrity finding", "parameters": [{ "$ref": "#/components/parameters/FindingId" }], "responses": { "200": { "$ref": "#/components/responses/Finding" }, "404": { "$ref": "#/components/responses/Error" } } }
    },
    "/api/v1/admin/audit-events": {
      "get": { "summary": "List bounded audit events", "parameters": [{ "$ref": "#/components/parameters/Limit" }, { "$ref": "#/components/parameters/Cursor" }], "responses": { "200": { "description": "Audit page", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AuditPageResponse" } } } } } }
    },
    "/api/v1/admin/audit-events/{id}": {
      "get": { "summary": "Get an audit event", "parameters": [{ "$ref": "#/components/parameters/AuditId" }], "responses": { "200": { "$ref": "#/components/responses/Audit" }, "404": { "$ref": "#/components/responses/Error" } } }
    },
    "/api/v1/admin/users": {
      "get": { "summary": "List tenant users (permission identity.read)", "parameters": [{ "$ref": "#/components/parameters/AdminLimit" }, { "$ref": "#/components/parameters/Cursor" }], "responses": { "200": { "description": "Admin user page", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AdminUserPageResponse" } } } }, "401": { "$ref": "#/components/responses/Error" }, "403": { "$ref": "#/components/responses/Error" } } }
    },
    "/api/v1/admin/users/{userId}": {
      "get": { "summary": "Get a tenant user (permission identity.read)", "parameters": [{ "$ref": "#/components/parameters/UserId" }], "responses": { "200": { "description": "Admin user", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AdminUserResponse" } } } }, "404": { "$ref": "#/components/responses/Error" } } }
    },
    "/api/v1/admin/tenant-memberships": {
      "get": { "summary": "List tenant memberships (permission identity.read)", "parameters": [{ "$ref": "#/components/parameters/AdminLimit" }, { "$ref": "#/components/parameters/Cursor" }], "responses": { "200": { "description": "Membership page", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MembershipPageResponse" } } } }, "403": { "$ref": "#/components/responses/Error" } } },
      "post": { "summary": "Create a tenant membership (permission identity.user.manage)", "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreateTenantMembershipRequest" } } } }, "responses": { "201": { "description": "Created membership", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MembershipResponse" } } } }, "200": { "description": "Idempotent replay", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MembershipResponse" } } } }, "400": { "$ref": "#/components/responses/Error" }, "409": { "$ref": "#/components/responses/Error" } } }
    },
    "/api/v1/admin/tenant-memberships/{userId}/suspend": {
      "post": { "summary": "Suspend a tenant membership (permission identity.membership.update)", "parameters": [{ "$ref": "#/components/parameters/UserId" }, { "$ref": "#/components/parameters/IdempotencyKey" }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MembershipStatusChangeRequest" } } } }, "responses": { "200": { "$ref": "#/components/responses/Membership" }, "400": { "$ref": "#/components/responses/Error" }, "404": { "$ref": "#/components/responses/Error" }, "409": { "$ref": "#/components/responses/Error" } } }
    },
    "/api/v1/admin/tenant-memberships/{userId}/reactivate": {
      "post": { "summary": "Reactivate a tenant membership (permission identity.membership.update; self-reaction is rejected)", "parameters": [{ "$ref": "#/components/parameters/UserId" }, { "$ref": "#/components/parameters/IdempotencyKey" }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MembershipStatusChangeRequest" } } } }, "responses": { "200": { "$ref": "#/components/responses/Membership" }, "400": { "$ref": "#/components/responses/Error" }, "404": { "$ref": "#/components/responses/Error" }, "409": { "$ref": "#/components/responses/Error" } } }
    },
    "/api/v1/admin/permissions": {
      "get": { "summary": "Read the permission catalog (permission policy.role.read)", "responses": { "200": { "description": "Permission catalog", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PermissionArrayResponse" } } } }, "403": { "$ref": "#/components/responses/Error" } } }
    },
    "/api/v1/admin/roles": {
      "get": { "summary": "List roles visible to the tenant (permission policy.role.read)", "responses": { "200": { "description": "Roles", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RoleArrayResponse" } } } }, "403": { "$ref": "#/components/responses/Error" } } },
      "post": { "summary": "Create a tenant role (permission policy.role.manage)", "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreateRoleRequest" } } } }, "responses": { "201": { "$ref": "#/components/responses/Role" }, "200": { "description": "Idempotent replay", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RoleResponse" } } } }, "400": { "$ref": "#/components/responses/Error" }, "409": { "$ref": "#/components/responses/Error" } } }
    },
    "/api/v1/admin/roles/{roleId}": {
      "get": { "summary": "Get a role with its permission keys (permission policy.role.read)", "parameters": [{ "$ref": "#/components/parameters/RoleId" }], "responses": { "200": { "$ref": "#/components/responses/Role" }, "404": { "$ref": "#/components/responses/Error" } } },
      "patch": { "summary": "Update a tenant role (permission policy.role.manage; system roles are immutable)", "parameters": [{ "$ref": "#/components/parameters/RoleId" }, { "$ref": "#/components/parameters/IdempotencyKey" }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UpdateRoleRequest" } } } }, "responses": { "200": { "$ref": "#/components/responses/Role" }, "400": { "$ref": "#/components/responses/Error" }, "404": { "$ref": "#/components/responses/Error" }, "409": { "$ref": "#/components/responses/Error" } } }
    },
    "/api/v1/admin/roles/{roleId}/permissions": {
      "put": { "summary": "Transactional set replace of a role's permissions (permission policy.role.manage)", "parameters": [{ "$ref": "#/components/parameters/RoleId" }, { "$ref": "#/components/parameters/IdempotencyKey" }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SetRolePermissionsRequest" } } } }, "responses": { "200": { "$ref": "#/components/responses/Role" }, "400": { "$ref": "#/components/responses/Error" }, "404": { "$ref": "#/components/responses/Error" }, "409": { "$ref": "#/components/responses/Error" } } }
    },
    "/api/v1/admin/role-bindings": {
      "get": { "summary": "List tenant role bindings, optionally by user (permission policy.binding.read)", "parameters": [{ "$ref": "#/components/parameters/UserIdQuery" }], "responses": { "200": { "description": "Role bindings", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RoleBindingArrayResponse" } } } }, "403": { "$ref": "#/components/responses/Error" } } },
      "post": { "summary": "Bind a role to a user (permission policy.binding.manage; self-escalation is rejected)", "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/BindingCreateRequest" } } } }, "responses": { "201": { "$ref": "#/components/responses/RoleBinding" }, "200": { "description": "Idempotent convergence", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RoleBindingResponse" } } } }, "400": { "$ref": "#/components/responses/Error" }, "404": { "$ref": "#/components/responses/Error" }, "409": { "$ref": "#/components/responses/Error" } } }
    },
    "/api/v1/admin/role-bindings/{bindingId}/revoke": {
      "post": { "summary": "Revoke a role binding (permission policy.binding.manage)", "parameters": [{ "$ref": "#/components/parameters/BindingId" }, { "$ref": "#/components/parameters/IdempotencyKey" }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/BindingRevokeRequest" } } } }, "responses": { "200": { "$ref": "#/components/responses/RoleBinding" }, "400": { "$ref": "#/components/responses/Error" }, "404": { "$ref": "#/components/responses/Error" }, "409": { "$ref": "#/components/responses/Error" } } }
    },
    "/api/v1/admin/organization-units": {
      "get": { "summary": "Flat listing of the tenant organization tree (permission organization.read)", "responses": { "200": { "description": "Organization units", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/OrganizationUnitArrayResponse" } } } }, "403": { "$ref": "#/components/responses/Error" } } },
      "post": { "summary": "Create an organization unit (permission organization.manage)", "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreateUnitRequest" } } } }, "responses": { "201": { "$ref": "#/components/responses/OrganizationUnit" }, "200": { "description": "Idempotent replay", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/OrganizationUnitResponse" } } } }, "400": { "$ref": "#/components/responses/Error" }, "409": { "$ref": "#/components/responses/Error" } } }
    },
    "/api/v1/admin/organization-units/{unitId}": {
      "patch": { "summary": "Update an organization unit (permission organization.manage)", "parameters": [{ "$ref": "#/components/parameters/UnitId" }, { "$ref": "#/components/parameters/IdempotencyKey" }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UpdateUnitRequest" } } } }, "responses": { "200": { "$ref": "#/components/responses/OrganizationUnit" }, "400": { "$ref": "#/components/responses/Error" }, "404": { "$ref": "#/components/responses/Error" }, "409": { "$ref": "#/components/responses/Error" } } }
    },
    "/api/v1/admin/organization-units/{unitId}/move": {
      "post": { "summary": "Reparent an organization unit (permission organization.manage; cycles are rejected)", "parameters": [{ "$ref": "#/components/parameters/UnitId" }, { "$ref": "#/components/parameters/IdempotencyKey" }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MoveUnitRequest" } } } }, "responses": { "200": { "$ref": "#/components/responses/OrganizationUnit" }, "400": { "$ref": "#/components/responses/Error" }, "404": { "$ref": "#/components/responses/Error" }, "409": { "$ref": "#/components/responses/Error" } } }
    },
    "/api/v1/admin/organization-units/{unitId}/members/{userId}": {
      "post": { "summary": "Add a member to an organization unit (permission organization.manage)", "parameters": [{ "$ref": "#/components/parameters/UnitId" }, { "$ref": "#/components/parameters/UserId" }, { "$ref": "#/components/parameters/IdempotencyKey" }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AddUnitMemberRequest" } } } }, "responses": { "201": { "$ref": "#/components/responses/OrganizationMember" }, "200": { "description": "Idempotent replay", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/OrganizationMemberResponse" } } } }, "400": { "$ref": "#/components/responses/Error" }, "404": { "$ref": "#/components/responses/Error" }, "409": { "$ref": "#/components/responses/Error" } } },
      "delete": { "summary": "Remove a member from an organization unit (permission organization.manage)", "parameters": [{ "$ref": "#/components/parameters/UnitId" }, { "$ref": "#/components/parameters/UserId" }, { "$ref": "#/components/parameters/IdempotencyKey" }, { "$ref": "#/components/parameters/MembershipType" }, { "$ref": "#/components/parameters/ExpectedVersion" }], "responses": { "200": { "$ref": "#/components/responses/OrganizationMember" }, "400": { "$ref": "#/components/responses/Error" }, "404": { "$ref": "#/components/responses/Error" }, "409": { "$ref": "#/components/responses/Error" } } }
    },
    "/api/v1/admin/organization-units/{unitId}/members": {
      "get": { "summary": "List members of an organization unit (permission organization.read)", "parameters": [{ "$ref": "#/components/parameters/UnitId" }], "responses": { "200": { "description": "Organization members", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/OrganizationMemberArrayResponse" } } } }, "403": { "$ref": "#/components/responses/Error" } } }
    },
    "/api/v1/admin/authorization/explain": {
      "post": { "summary": "Explain one authorization decision for a target user (permission policy.explain)", "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ExplainRequest" } } } }, "responses": { "200": { "description": "Bounded decision explanation", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ExplainResponse" } } } }, "400": { "$ref": "#/components/responses/Error" }, "403": { "$ref": "#/components/responses/Error" } } }
    }
  },
  "components": {
    "securitySchemes": { "bearerAuth": { "type": "http", "scheme": "bearer" } },
    "parameters": {
      "Limit": { "name": "limit", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 20 } },
      "Cursor": { "name": "cursor", "in": "query", "schema": { "type": "string", "description": "Versioned opaque cursor" } },
      "IdempotencyKey": { "name": "Idempotency-Key", "in": "header", "required": true, "schema": { "type": "string", "maxLength": 255 } },
      "DocumentId": { "name": "documentId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } },
      "JobId": { "name": "jobId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } },
      "FindingId": { "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } },
      "AuditId": { "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } },
      "UserId": { "name": "userId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } },
      "RoleId": { "name": "roleId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } },
      "BindingId": { "name": "bindingId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } },
      "UnitId": { "name": "unitId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } },
      "UserIdQuery": { "name": "user_id", "in": "query", "schema": { "type": "string", "format": "uuid" } },
      "MembershipType": { "name": "membership_type", "in": "query", "schema": { "type": "string", "enum": ["member", "leader"] } },
      "ExpectedVersion": { "name": "expected_version", "in": "query", "required": true, "schema": { "type": "integer", "minimum": 1 } },
      "AdminLimit": { "name": "limit", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 200, "default": 50 } }
    },
    "responses": {
      "Error": { "description": "Stable error", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
      "ProcessingJob": { "description": "Processing job", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ProcessingJobResponse" } } } },
      "ReviewResult": { "description": "Review result", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ReviewResultResponse" } } } },
      "Candidate": { "description": "Extraction candidate", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CandidateResponse" } } } },
      "Finding": { "description": "Integrity finding", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/FindingResponse" } } } },
      "Audit": { "description": "Audit event", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AuditResponse" } } } },
      "Membership": { "description": "Tenant membership", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MembershipResponse" } } } },
      "Role": { "description": "Role", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RoleResponse" } } } },
      "RoleBinding": { "description": "Role binding", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RoleBindingResponse" } } } },
      "OrganizationUnit": { "description": "Organization unit", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/OrganizationUnitResponse" } } } },
      "OrganizationMember": { "description": "Organization member", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/OrganizationMemberResponse" } } } }
    },
    "schemas": {
      "ErrorResponse": { "type": "object", "required": ["code", "message", "request_id"], "properties": { "code": { "type": "string" }, "message": { "type": "string" }, "request_id": { "type": "string" }, "trace_id": { "type": ["string", "null"] }, "details": { "type": ["object", "null"] } } },
      "Document": { "type": "object", "required": ["id", "original_filename", "content_type", "status", "version", "content_revision", "created_at", "updated_at"], "properties": { "id": { "type": "string", "format": "uuid" }, "original_filename": { "type": "string" }, "content_type": { "type": "string" }, "status": { "type": "string" }, "version": { "type": "integer" }, "content_revision": { "type": "integer" }, "size_bytes": { "type": ["integer", "null"] }, "created_at": { "type": "string", "format": "date-time" }, "updated_at": { "type": "string", "format": "date-time" } } },
      "ProcessingJob": { "type": "object", "required": ["job_id", "document_id", "content_revision", "status", "current_step", "attempt_count", "cancel_requested", "candidate_available", "review_available", "created_at", "updated_at"], "properties": { "job_id": { "type": "string", "format": "uuid" }, "document_id": { "type": "string", "format": "uuid" }, "content_revision": { "type": "integer" }, "status": { "type": "string" }, "current_step": { "type": "string" }, "attempt_count": { "type": "integer" }, "failure_code": { "type": ["string", "null"] }, "cancel_requested": { "type": "boolean" }, "candidate_available": { "type": "boolean" }, "review_available": { "type": "boolean" }, "created_at": { "type": "string", "format": "date-time" }, "updated_at": { "type": "string", "format": "date-time" } } },
      "Candidate": { "type": "object", "required": ["candidate_id", "job_id", "content_revision", "schema_version", "payload", "evidence", "provider", "model", "prompt_version", "version", "created_at"], "properties": { "candidate_id": { "type": "string", "format": "uuid" }, "job_id": { "type": "string", "format": "uuid" }, "content_revision": { "type": "integer" }, "schema_version": { "type": "string" }, "payload": { "type": "object" }, "evidence": { "type": "array", "items": { "type": "object" } }, "provider": { "type": "string" }, "model": { "type": "string" }, "prompt_version": { "type": "string" }, "version": { "type": "integer" }, "created_at": { "type": "string", "format": "date-time" } } },
